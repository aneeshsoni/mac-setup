{
  "name": "aneesh_vscode_setup",
  "settings": "{\"settings\":\"{\\n  \\\"terminal.integrated.fontFamily\\\": \\\"Meslo LG L DZ For Powerline\\\",\\n  \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"window.zoomLevel\\\": 0,\\n  \\\"files.associations\\\": {\\n    \\\"*.embeddedhtml\\\": \\\"html\\\",\\n    \\\"*.rmd\\\": \\\"markdown\\\",\\n  },\\n  \\\"Prettier-SQL.keywordCase\\\": \\\"lower\\\",\\n  \\\"editor.acceptSuggestionOnEnter\\\": \\\"off\\\",\\n  // Fonts and Sizes\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.multiCursorModifier\\\": \\\"ctrlCmd\\\",\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"editor.selectionHighlightBackground\\\": \\\"#ff78a091\\\",\\n    \\\"editor.selectionBackground\\\": \\\"#28b4ff93\\\",\\n  },\\n  \\\"jupyter.interactiveWindow.textEditor.executeSelection\\\": true,\\n  // Prettier as the formatter for web files\\n  \\\"[javascript]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[javascriptreact]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[typescript]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[typescriptreact]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[json]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[jsonc]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[css]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[scss]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n  \\\"[html]\\\": { \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\" },\\n\\n  // Optional: run ESLint fixes on save alongside Prettier for TS/JS\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.fixAll.eslint\\\": \\\"explicit\\\",\\n    // keep your Ruff fix separate via the [python] block you already have\\n    \\\"source.fixAll.ruff\\\": \\\"explicit\\\",\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.formatOnType\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.codeActionsOnSave\\\": {\\n      \\\"source.fixAll.ruff\\\": \\\"explicit\\\",\\n      \\\"source.organizeImports\\\": \\\"explicit\\\",\\n    },\\n  },\\n  \\\"ruff.configurationPreference\\\": \\\"filesystemFirst\\\",\\n  \\\"ruff.logLevel\\\": \\\"debug\\\",\\n  \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n  \\\"github.copilot.nextEditSuggestions.enabled\\\": true,\\n  \\\"chat.mcp.autostart\\\": \\\"newAndOutdated\\\",\\n  \\\"workbench.colorTheme\\\": \\\"Aura Dracula Spirit (Soft)\\\",\\n  \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n  \\\"editor.cursorStyle\\\": \\\"line\\\",\\n  \\\"chat.agent.maxRequests\\\": 40,\\n  \\\"database-client.autoSync\\\": true,\\n  \\\"[prisma]\\\": {},\\n  \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n  \\\"python.terminal.activateEnvInCurrentTerminal\\\": true,\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"claudeCode.selectedModel\\\": \\\"haiku\\\",\\n  \\\"editor.inlineSuggest.enabled\\\": false,\\n}\\n\"}",
  "keybindings": "{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+n\\\",\\n    \\\"command\\\": \\\"code-runner.run\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+n\\\",\\n    \\\"command\\\": \\\"-code-runner.run\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+=\\\",\\n    \\\"command\\\": \\\"editor.action.fontZoomIn\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+-\\\",\\n    \\\"command\\\": \\\"editor.action.fontZoomOut\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+/\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.new\\\",\\n    \\\"when\\\": \\\"terminalProcessSupported || terminalWebExtensionContributedProfile\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+`\\\",\\n    \\\"command\\\": \\\"-workbench.action.terminal.new\\\",\\n    \\\"when\\\": \\\"terminalProcessSupported || terminalWebExtensionContributedProfile\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+i\\\",\\n    \\\"command\\\": \\\"-workbench.action.chat.openEditSession\\\",\\n    \\\"when\\\": \\\"chatEditingParticipantRegistered && !chatSetupHidden && view != 'workbench.panel.chat.view.edits'\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"workbench.panel.chat\\\",\\n    \\\"when\\\": \\\"workbench.panel.chat.view.copilot.active\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+cmd+i\\\",\\n    \\\"command\\\": \\\"-workbench.panel.chat\\\",\\n    \\\"when\\\": \\\"workbench.panel.chat.view.copilot.active\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"-expandLineSelection\\\",\\n    \\\"when\\\": \\\"textInputFocus\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"up\\\",\\n    \\\"command\\\": \\\"-notebook.cell.chat.previousFromHistory\\\",\\n    \\\"when\\\": \\\"inlineChatFocused && notebookCellChatFocused\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"down\\\",\\n    \\\"command\\\": \\\"-notebook.cell.chat.nextFromHistory\\\",\\n    \\\"when\\\": \\\"inlineChatFocused && notebookCellChatFocused\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+c\\\",\\n    \\\"command\\\": \\\"-workbench.action.terminal.openNativeConsole\\\",\\n    \\\"when\\\": \\\"!terminalFocus\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"workbench.view.extension.codexSecondaryViewContainer\\\",\\n  },\\n]\\n\",\"platform\":1}",
  "extensions": "[{\"identifier\":{\"id\":\"anthropic.claude-code\",\"uuid\":\"3c13ae49-babe-45fe-8c48-5e45077a62bf\"},\"displayName\":\"Claude Code for VS Code\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"charliermarsh.ruff\",\"uuid\":\"c2ca9b43-fa38-44fc-928e-5125970b9c00\"},\"displayName\":\"Ruff\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"cweijan.dbclient-jdbc\",\"uuid\":\"1fe0d785-8db6-44ef-8113-cb0d98a88473\"},\"displayName\":\"Database Client JDBC\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"cweijan.vscode-database-client2\",\"uuid\":\"6ba92c55-a4a0-43f8-8aeb-cc3a03558814\"},\"displayName\":\"Database Client\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"dbaeumer.vscode-eslint\",\"uuid\":\"583b2b34-2c1e-4634-8c0b-0b82e283ea3a\"},\"displayName\":\"ESLint\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"esbenp.prettier-vscode\",\"uuid\":\"96fa4707-6983-4489-b7c5-d5ffdfdcce90\"},\"displayName\":\"Prettier - Code formatter\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"formulahendry.auto-rename-tag\",\"uuid\":\"6e440e71-8ed9-4f25-bb78-4b13096b8a03\"},\"displayName\":\"Auto Rename Tag\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"inferrinizzard.prettier-sql-vscode\",\"uuid\":\"386997b1-f715-42f5-91e4-618a439c19b8\"},\"displayName\":\"Prettier SQL VSCode\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"josemurilloc.aura-spirit-dracula\",\"uuid\":\"98e2ad89-0613-4b2f-a56f-ef3386d21d78\"},\"displayName\":\"Aura Spirit Dracula Theme\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.debugpy\",\"uuid\":\"4bd5d2c9-9d65-401a-b0b2-7498d9f17615\"},\"displayName\":\"Python Debugger\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.python\",\"uuid\":\"f1f59ae4-9318-4f3c-a9b5-81b2eaa5f8a5\"},\"displayName\":\"Python\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.vscode-python-envs\",\"uuid\":\"b41d8e8a-b6d4-4202-8f07-7189bdda81be\"},\"displa